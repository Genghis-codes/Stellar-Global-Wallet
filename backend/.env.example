# ---------------------------------------------------------------------------
# Stellar Global Wallet — backend environment template
# Copy to .env and fill in. Testnet defaults work out of the box.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# ── Stellar network ───────────────────────────────────────────────────────
# testnet | mainnet
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Maximum upstream response size (bytes) accepted before failing closed (default: 2 MiB).
# HORIZON_MAX_RESPONSE_BYTES=2097152
# SOROBAN_RPC_MAX_RESPONSE_BYTES=2097152

# --- Stellar / contract -----------------------------------------------------
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
CONTRACT_ID=CDEMO0000000000000000000000000000000000000000000000000000

# --- Secrets provider -------------------------------------------------------
# Selects where rotatable secrets are loaded from.
#   env  — read from process environment (default; local dev / simple deploys)
#   vault — HashiCorp Vault KV v2
#   aws  — AWS Secrets Manager
# Rotated values are hot-reloaded without a redeploy (see backend/docs/secrets-rotation.md).
SECRET_PROVIDER=env

# Poll interval (ms) for detecting rotated secrets. 0 disables hot reload.
SECRET_RELOAD_INTERVAL_MS=30000

# --- Vault (SECRET_PROVIDER=vault) ------------------------------------------
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_NAMESPACE=
# KV v2 mount + path holding the secret bundle (JSON object of key/value pairs).
VAULT_SECRET_MOUNT=secret
VAULT_SECRET_PATH=stellar-wallet/backend

# --- AWS Secrets Manager (SECRET_PROVIDER=aws) ------------------------------
AWS_REGION=us-east-1
# Secret id/ARN holding the JSON bundle. Credentials come from the standard
# AWS provider chain (instance role / task role) — do not hardcode keys here.
AWS_SECRETS_MANAGER_SECRET_ID=stellar-wallet/backend

# --- JWT --------------------------------------------------------------------
# Rotatable. When using a managed provider these are supplied by the bundle.
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

# --- Sponsor keys -----------------------------------------------------------
# Sponsor signing keys live in KMS and are never materialised in the process.
#   env — local dev only: raw secret key from SPONSOR_SECRET_KEY
#   kms — remote signing via AWS KMS (recommended for Render deployments)
SPONSOR_SIGNER=env
SPONSOR_PUBLIC_KEY=
# Local dev only. Never commit a real key.
SPONSOR_SECRET_KEY=
# AWS KMS (SPONSOR_SIGNER=kms)
SPONSOR_KMS_KEY_ID=

# --- SMTP -------------------------------------------------------------------
# Rotatable. Supplied by the secret bundle when a managed provider is used.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
