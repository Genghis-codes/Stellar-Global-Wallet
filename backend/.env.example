# Copy to .env and adjust. Every key here is read by src/config.ts; values
# below work for local development against Stellar testnet with the
# docker-compose Postgres and Redis.

# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Trusted reverse-proxy hops in front of the API (0 when running locally
# without a proxy). See config.ts before changing this in production.
TRUST_PROXY_HOPS=0

# ── Stellar network ───────────────────────────────────────────────────────
# testnet | mainnet
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# globe-wallet contract deployed on testnet with a demo user, so the
# /api/v1/contract/* routes work with zero setup. Leave empty to disable them.
GLOBE_WALLET_CONTRACT_ID=CBGLPMNSM4FWMIZ6FFBSRN7FNVCHCI2SLZNODA27LEOXFPLWNYEAEP3K
# TOKEN_WRAPPER_CONTRACT_ID=
# MIN_CLIENT_VERSION=0.1.0

# ── Storage ───────────────────────────────────────────────────────────────
# Matches docker-compose.yml.
DATABASE_URL=postgresql://user:password@localhost:5432/globewallet
REDIS_URL=redis://localhost:6379
# in-process (single instance) | redis (required with more than one instance)
LOCK_BACKEND=in-process

# ── Auth ──────────────────────────────────────────────────────────────────
# JWT signing secret for access tokens. Use a long random value in production.
JWT_SECRET=change-me-in-production
# Shared key for POST /api/v1/auth/login (legacy single-identity login).
API_KEY=change-me-in-production
# SEP-10 wallet sign-in. Set an S... seed to enable /auth/challenge and
# /auth/token; the domains must match the wallet's stellar.toml.
# SEP10_SIGNING_SECRET=
# HOME_DOMAIN=globewallet.app
# WEB_AUTH_DOMAIN=globewallet.app

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated origins, each validated as a URL at startup. exp:// works
# for Expo dev.
CORS_ORIGIN=http://localhost:3000
# Optional regex for preview deploys, e.g.
# CORS_ORIGIN_REGEX=^https://globe-wallet-[a-z0-9-]+\.vercel\.app$

# ── Prices, FX and history ────────────────────────────────────────────────
PRICE_PROVIDERS=stellar_dex,coingecko
PRICE_CACHE_TTL_SECONDS=30
# PRICE_USDC_ISSUER=
# COINGECKO_API_KEY=
# FX_API_URL=https://open.er-api.com/v6/latest/USD
# FX_CACHE_TTL_MS=3600000
# HISTORY_SCAN_CAP=1000

# ── Payment flags and verified assets ─────────────────────────────────────
SPAM_DUST_THRESHOLD=0.5
# Extra CODE:ISSUER pairs on top of data/verified-assets.<network>.json
VERIFIED_ASSETS=

# ── Email notifications ───────────────────────────────────────────────────
# console | resend | ses
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@globewallet.app
BASE_URL=http://localhost:3000
# RESEND_API_KEY=
# AWS_SES_REGION=
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_SECRET_ACCESS_KEY=

# ── Feature flags and docs ────────────────────────────────────────────────
# e.g. FEATURE_FLAGS=recovery:true
FEATURE_FLAGS=
# Swagger UI at /api/docs; defaults to on outside production.
# ENABLE_API_DOCS=true
