{
  "name": "globe-wallet-backend",
  "version": "0.1.0",
  "private": true,
  "description": "GlobeWallet REST API — Node.js + Express + TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "jest",
    "test:e2e": "E2E_TESTNET=1 jest --config jest.e2e.config.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "seed:demo": "tsx scripts/seed-demo-wallet.ts"
  },
  "dependencies": {
    "@globe-wallet/sdk": "^0.1.0",
    "@iarna/toml": "^2.2.5",
    "@stellar-global-wallet/types": "^0.1.0",
    "@stellar/stellar-sdk": "^16.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "redis": "^4.6.13",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.4.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.2",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-openapi": "^0.14.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "tsx": "^4.7.1",
    "typescript": "^5.5.2"
  }
}
