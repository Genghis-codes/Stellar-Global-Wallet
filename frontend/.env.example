# Copy to .env.local and adjust. Every variable here is public (NEXT_PUBLIC_*)
# and ends up in the browser bundle: never put secrets in this file.

# Base URL of the GlobeWallet backend (backend/, default port 4000).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Stellar network the app expects Freighter to be on: testnet | mainnet | futurenet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Horizon server used for read-only helpers (explorer links, account lookups).
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Block explorer used for transaction/account links.
NEXT_PUBLIC_EXPLORER_URL=https://stellar.expert/explorer

# Request timeout for API calls, in milliseconds.
NEXT_PUBLIC_API_TIMEOUT_MS=15000
