{
  "name": "@globe-wallet/sdk",
  "version": "0.1.0",
  "description": "Typed client for the GlobeWallet API and Soroban contracts. Works in Node, browsers and React Native.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Genghis-codes/Stellar-Global-Wallet.git",
    "directory": "packages/sdk"
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "node --test --import tsx tests/validate.test.ts tests/format.test.ts tests/lookalike.test.ts tests/client.test.ts",
    "test:smoke": "node --test --import tsx tests/smoke/preview-api.test.ts"
  },
  "dependencies": {
    "@globe-wallet/bindings-globe-wallet": "^0.0.0",
    "@stellar/stellar-sdk": "^17.3.0"
  },
  "devDependencies": {
    "tsx": "^4.7.1",
    "typescript": "^5.6.0"
  }
}
