{
  "description": "Shared test vectors for issue #103 — run against both the SDK (packages/sdk/tests/validate.test.ts) and the backend (backend/src/__tests__/validation.test.ts) to prove they validate identically.",
  "addresses": [
    { "value": "GBLIQBXTAF3O3YINCRDR5O7H47QHHW5GFOYN4HAD6IKOSWD4LWKWWPHP", "valid": true, "note": "real demo account from backend/.env.example" },
    { "value": "GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF", "valid": true, "note": "56 chars, starts with G" },
    { "value": "MA7QYNF7SOWQ3GLR2BGMZEHXAVAVFVUEDFLVDPQEHLRWNA", "valid": false, "note": "muxed M-address, rejected on purpose" },
    { "value": "GSHORT", "valid": false, "note": "too short" },
    { "value": "", "valid": false, "note": "empty string" },
    { "value": 12345, "valid": false, "note": "not a string" }
  ],
  "memos": [
    { "value": "hello world", "validBytes": true, "note": "11 ASCII chars/bytes, well under 28" },
    { "value": "exactly 28 ascii bytes here", "validBytes": true, "note": "28 ASCII chars = 28 bytes, boundary" },
    { "value": "this is way too many ascii characters for a memo", "validBytes": false, "note": "over 28 bytes" },
    { "value": "日本語日本語日本語日本語", "validBytes": false, "note": "12 chars but 36 bytes (3 bytes/char) — passes a char-count check, fails the real byte check" },
    { "value": "日本語日本", "validBytes": true, "note": "5 chars, 15 bytes — fits under 28 bytes" }
  ],
  "amounts": [
    { "value": "100", "valid": true },
    { "value": "0.0000001", "valid": true, "note": "1 stroop, minimum positive amount" },
    { "value": "1234.567", "valid": true },
    { "value": "0", "valid": false, "note": "zero is not a valid payment amount" },
    { "value": "0.00000000", "valid": false, "note": "zero, many decimals" },
    { "value": "12.50000001", "valid": false, "note": "8 decimal places, one too many" },
    { "value": "-5", "valid": false, "note": "negative" },
    { "value": "abc", "valid": false, "note": "not numeric" }
  ]
}
